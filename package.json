{
  "name": "aitemplate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel --kill-others dev:frontend dev:backend",
    "dev:frontend": "vite --open",
    "start": "convex dev",
    "dev:sequential": "npm run dev:backend & npm run dev:frontend",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "tsc -b && vite build",
    "lint": "tsc && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.25.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@google/genai": "^2.5.0",
    "@heroicons/react": "^2.2.0",
    "@langchain/core": "^1.1.38",
    "@langchain/google": "^0.1.9",
    "@langchain/openai": "^1.4.1",
    "@remixicon/react": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.27.0",
    "daisyui": "^5.1.26",
    "dayjs": "^1.11.18",
    "embla-carousel-react": "^8.6.0",
    "fs": "^0.0.1-security",
    "langchain": "^1.2.39",
    "lucide-react": "^0.548.0",
    "moment": "^2.30.1",
    "openai": "^6.3.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-lazy-load-image-component": "^1.6.3",
    "react-router": "^7.9.4",
    "react-router-dom": "^7.9.5",
    "shadcn": "^4.1.0",
    "sharp": "^0.34.5",
    "styled-components": "^6.3.12",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animated": "^2.0.0",
    "theme-change": "^2.5.0",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-image-optimizer": "^2.0.2",
    "vite-plugin-svgr": "^4.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-lazy-load-image-component": "^1.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svgo": "^4.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
