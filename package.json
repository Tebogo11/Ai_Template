{
  "name": "aitemplate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel --kill-others dev:frontend dev:backend",
    "dev:frontend": "vite --open",
    "dev:backend": "convex dev",
    "dev:sequential": "npm run dev:backend & npm run dev:frontend",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "tsc -b && vite build",
    "lint": "tsc && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.25.0",
    "@google/genai": "^1.24.0",
    "@heroicons/react": "^2.2.0",
    "@langchain/core": "^0.3.78",
    "@langchain/openai": "^0.6.14",
    "clsx": "^2.1.1",
    "convex": "^1.27.0",
    "daisyui": "^5.1.26",
    "fs": "^0.0.1-security",
    "langchain": "^0.3.35",
    "openai": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss-animated": "^2.0.0",
    "theme-change": "^2.5.0",
    "vite-plugin-svgr": "^4.5.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
